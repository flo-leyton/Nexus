{
  "expo": {
    "name": "Nexus",
    "slug": "Nexus",
    "owner": "flo-leytons-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/nexus-official/icon.png",
    "scheme": "nexus",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.floleyton.nexus",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#131018",
        "foregroundImage": "./assets/nexus-official/adaptive-icon.png",
        "monochromeImage": "./assets/nexus-official/monochrome-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/nexus-official/notification-icon.png"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permite que Nexus use la cámara para grabar vídeos locales de Studio.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "granularPermissions": [],
          "savePhotosPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite que Nexus seleccione imágenes y videos para importarlos a Studio.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/nexus-official/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#131018"
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5af287be-187e-46bc-b9ff-1412a6a21a1a"
      }
    }
  }
}
