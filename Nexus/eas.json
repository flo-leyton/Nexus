{
  "cli": {
    "version": ">= 27.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "credentialsSource": "remote"
      }
    },
    "development-nx10": {
      "extends": "development",
      "env": {
        "NEXUS_NX10_NATIVE": "1",
        "NEXUS_NX10_WEBRTC_NATIVE": "1"
      }
    },
    "preview": {
      "environment": "preview",
      "developmentClient": false,
      "distribution": "internal",
      "node": "24.15.0",
      "autoIncrement": true,
      "env": {
        "EXPO_NO_DOTENV": "1",
        "NEXUS_ONLINE_BUILD": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "presentation-nx10": {
      "extends": "preview",
      "autoIncrement": false,
      "env": {
        "NEXUS_NX10_NATIVE": "1",
        "NEXUS_NX10_WEBRTC_NATIVE": "1",
        "EXPO_PUBLIC_NEXUS_NX10_WEBRTC": "1",
        "EXPO_PUBLIC_RELAY_URL": "wss://nexus-relay-devb.onrender.com"
      },
      "android": {
        "credentialsSource": "remote"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "EXPO_NO_DOTENV": "1",
        "NEXUS_ONLINE_BUILD": "1"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
