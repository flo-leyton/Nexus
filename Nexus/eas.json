{
  "cli": {
    "version": ">= 27.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "environment": "preview",
      "developmentClient": false,
      "distribution": "internal",
      "node": "24.15.0",
      "autoIncrement": true,
      "env": {
        "EXPO_NO_DOTENV": "1",
        "NEXUS_ONLINE_BUILD": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "EXPO_NO_DOTENV": "1",
        "NEXUS_ONLINE_BUILD": "1"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
